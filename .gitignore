# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Data (large, local-only)
SPX_calls_surfaces.csv
SPX_puts_surfaces.csv
_data_prep/*.csv

# Generated outputs.
# Tracked across machines: best_model.pt, config.json, start_dates.npy,
# train_log.csv, meta.json — needed to regenerate predictions deterministically.
# Ignored: preds.npy and true.npy — large, regenerated by `--predict_only` mode.
preds.npy
true.npy
checkpoint.pt
*.ckpt

# Exception: VAR is deterministic (frozen two-stage Gonçalves-Guidolin), the
# preds file is small (~9MB), and train.py's per-regime breakdown wants it
# present on every machine. Track it so it survives a fresh clone on Colab.
!VAR/results/*/preds.npy
!VAR/eval/*/preds.npy

_trading/

# Legacy DynGWN data / artifacts
DynGWN/data/**
DynGWN/logs/**

# Reference implementations not part of the active pipeline
/PI-ConvTF/
/viz_stuff/

# Misc
*.log
*.tmp

# LaTeX auxiliary files
report/build/
report/*.aux
report/*.bbl
report/*.bcf
report/*.blg
report/*.lof
report/*.lot
report/*.maf
report/*.mtc
report/*.mtc0
report/*.out
report/*.run.xml
report/*.toc
report/*.fdb_latexmk
report/*.fls
report/*.synctex.gz
# Keep main.tex and main.pdf
!report/main.tex
!report/main.pdf

_data_prep/data/*
_data_prep/out_hm_8e-4
_data_prep/out_hm_2e-4_6e-4

