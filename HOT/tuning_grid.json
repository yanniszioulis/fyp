{
  "_variants": [
    {"name": "kronecker_product", "fix": {"attention_type": "kronecker_product"}},
    {"name": "kronecker_sum",     "fix": {"attention_type": "kronecker_sum"}}
  ],

  "epochs": 100,
  "batch_size": 32,
