{
  "epochs": 100,
  "patience": 15,
  "min_epochs": 30,
  "batch_size": 32,
  "loss": "mse",

  "revin": true,
  "revin_affine": false,
  "head_init_scale": 0.001,

  "_d_model_n_heads_pairs": [
    {"d_model": 32, "n_heads": 4},
    {"d_model": 64, "n_heads": 4},
    {"d_model": 64, "n_heads": 8}
  ],

  "n_blocks":     [1, 2],
  "ffn_ratio":    [2, 4],
  "dropout":      [0.1, 0.3],
  "lr":           [1e-3, 5e-4],
  "weight_decay": [1e-3, 5e-2]
}
